                        <div><label className="block text-sm font-medium text-gray-400 mb-1">Likelihood (1-5)</label><input type="range" name="likelihood" min="1" max="5" value={formData.likelihood || 3} onChange={handleChange} className="w-full"/></div>
                        <div><label className="block text-sm font-medium text-gray-400 mb-1">Impact (1-5)</label><input type="range" name="impact" min="1" max="5" value={formData.impact || 3} onChange={handleChange} className="w-full"/></div>
                    </div>
                    <div>
                        <div className="flex justify-between items-center mb-1">
