const SuccessMetricModal = ({ isOpen, onClose, db, userId, project, editingMetric }) => {
    const [formData, setFormData] = useState({});
    const [isGenerating, setIsGenerating] = useState(false);
    
    useEffect(() => {
        if(editingMetric) {
            setFormData(editingMetric);
        } else {
            setFormData({ metric: '', category: 'Business Outcome', target: 0, current: 0, status: 'On Track', dataSource: '' });
        }
    }, [editingMetric, isOpen]);

    const handleChange = (e) => {
        const { name, value } = e.target;
        setFormData(prev => ({ ...prev, [name]: (name === 'target' || name === 'current') ? Number(value) : value }));
    };

    const handleSuggestMetrics = async () => {
        setIsGenerating(true);
        const prompt = `As a change management expert, suggest one key success metric for a project called "${project.name}". The metric should be in the category of "${formData.category}". Provide a concise, one-sentence description for the metric.`;
        const suggestion = await callGeminiAPI(prompt);
        setFormData(prev => ({ ...prev, metric: suggestion }));
        setIsGenerating(false);
    };

    const handleSubmit = async (e) => {
        e.preventDefault();
        const collectionRef = collection(db, `artifacts/${appId}/users/${userId}/projects/${project.id}/successMetrics`);
        if (formData.id) {
            await updateDoc(doc(collectionRef, formData.id), formData);
        } else {
            await addDoc(collectionRef, { ...formData, createdAt: serverTimestamp() });
        }
        onClose();
    };
    
    if (!isOpen) return null;
    return (
        <div className="fixed inset-0 bg-black bg-opacity-70 flex justify-center items-center z-50">
            <div className="bg-[#1F1F1F] border border-[#333] p-8 rounded-lg shadow-2xl w-full max-w-lg m-4">
                <h3 className="font-jakarta text-2xl font-bold text-[#B38B59] mb-6">{formData.id ? 'Edit' : 'Add'} Success Metric</h3>
                <form onSubmit={handleSubmit} className="space-y-4">
                     <select name="category" value={formData.category || 'Business Outcome'} onChange={handleChange} className="w-full p-2 border border-[#333] rounded-md bg-[#141414] text-[#F3F4F6]">
                        <option>Business Outcome</option><option>Adoption</option><option>Proficiency</option><option>Sentiment</option>
                    </select>
                     <div>
                        <div className="flex justify-between items-center mb-1">
                             <label className="block text-sm font-medium text-gray-400">Metric Description</label>
                            <button type="button" onClick={handleSuggestMetrics} disabled={isGenerating} className="flex items-center gap-2 text-sm text-[#B38B59] hover:text-[#a17c50] disabled:opacity-50">
                                {isGenerating ? <LoadingSpinner small/> : <ICONS.Sparkles className="w-4 h-4" />}
                                ✨ Suggest Metric
                            </button>
                        </div>
                        <textarea name="metric" value={formData.metric || ''} onChange={handleChange} placeholder="e.g., Increase lead conversion rate by 15%" required className="w-full p-2 border border-[#333] rounded-md bg-[#141414] text-[#F3F4F6] min-h-[80px]"></textarea>
                    </div>
                    <div className="grid grid-cols-2 gap-4">
                         <input type="number" name="target" value={formData.target || 0} onChange={handleChange} placeholder="Target Value" required className="w-full p-2 border border-[#333] rounded-md bg-[#141414] text-[#F3F4F6]"/>
                         <input type="number" name="current" value={formData.current || 0} onChange={handleChange} placeholder="Current Value" required className="w-full p-2 border border-[#333] rounded-md bg-[#141414] text-[#F3F4F6]"/>
                    </div>
                     <select name="status" value={formData.status || 'On Track'} onChange={handleChange} className="w-full p-2 border border-[#333] rounded-md bg-[#141414] text-[#F3F4F6]">
                        <option>On Track</option><option>At Risk</option><option>Off Track</option><option>Achieved</option>
                    </select>
                     <input type="text" name="dataSource" value={formData.dataSource || ''} onChange={handleChange} placeholder="Data Source (e.g., Salesforce Report)" required className="w-full p-2 border border-[#333] rounded-md bg-[#141414] text-[#F3F4F6]"/>
