const ChangeManagementApp = ({ db, userId }) => {
    const [activePage, setActivePage] = useState('Admin');
    const [customers, setCustomers] = useState([]); const [projectsByCustomer, setProjectsByCustomer] = useState({});
    const [selectedCustomer, setSelectedCustomer] = useState(null); const [selectedProject, setSelectedProject] = useState(null);
    const [profile, setProfile] = useState({ name: `User: ${userId.substring(0, 8)}...`, role: 'Change Manager' });

    useEffect(() => {
        if (!userId || !db) return;
        const profileRef = doc(db, `artifacts/${appId}/users/${userId}/profile`, 'main');
        const unsubProfile = onSnapshot(profileRef, (docSnap) => { if (docSnap.exists()) { setProfile(prev => ({...prev, ...docSnap.data()})); } });
        const customersRef = collection(db, `artifacts/${appId}/users/${userId}/customers`);
        const unsubCustomers = onSnapshot(customersRef, (snapshot) => {
            const customerList = snapshot.docs.map(doc => ({ id: doc.id, ...doc.data() })); setCustomers(customerList);
            if (!selectedCustomer && customerList.length > 0) { setSelectedCustomer(customerList[0].id); }
            customerList.forEach(customer => {
                 const projectsRef = collection(db, `artifacts/${appId}/users/${userId}/customers/${customer.id}/projects`);
                 onSnapshot(projectsRef, (projSnapshot) => {
                     const projectList = projSnapshot.docs.map(doc => ({ id: doc.id, ...doc.data() }));
                     setProjectsByCustomer(prev => ({...prev, [customer.id]: projectList}));
                 });
            });
        });
        return () => { unsubProfile(); unsubCustomers(); };
    }, [userId, db, selectedCustomer]);

    const projectsForSelectedCustomer = projectsByCustomer[selectedCustomer] || [];
    const selectedProjectData = useMemo(() => { return projectsForSelectedCustomer.find(p => p.id === selectedProject); }, [projectsForSelectedCustomer, selectedProject]);
    const handleProfileUpdate = (newProfile) => { setProfile(prev => ({...prev, ...newProfile})); };

    const renderPage = () => {
        if (activePage === 'Admin') { return <AdminPage db={db} userId={userId} onProfileUpdate={handleProfileUpdate} customers={customers} projectsByCustomer={projectsByCustomer}/>; }
        if (!selectedProject) { return ( <div className="p-8 text-center text-gray-400"> <h2 className="font-jakarta text-2xl font-bold text-white">Welcome to Atelier AI</h2> <p className="mt-4">Please select a project to begin.</p> </div> ); }
        switch (activePage) {
            case 'Stakeholders': return <StakeholderPage db={db} userId={userId} project={selectedProjectData} />;
            case 'RiskManagement': return <RiskManagementPage db={db} userId={userId} project={selectedProjectData} />;
            case 'ImpactAnalysis': return <ImpactAnalysisPage db={db} userId={userId} project={selectedProjectData} />;
            case 'Capability': return <CapabilityPage db={db} userId={userId} project={selectedProjectData} />;
            case 'SuccessMetrics': return <SuccessMetricsPage db={db} userId={userId} project={selectedProjectData} />;
            default: return <PagePlaceholder title={NAV_ITEMS.find(i => i.id === activePage)?.title || activePage} />;
        }
    };
    
    return (
        <div className="flex h-screen font-inter">
            <Sidebar activePage={activePage} setActivePage={setActivePage} />
            <div className="flex-1 flex flex-col min-w-0">
                <Header customers={customers} projects={projectsForSelectedCustomer} selectedCustomer={selectedCustomer} setSelectedCustomer={setSelectedCustomer} selectedProject={selectedProject} setSelectedProject={setSelectedProject} userName={profile.name} userRole={profile.role} />
                <div className="flex-1 flex overflow-hidden">
                    <main className="flex-1 overflow-y-auto bg-[#141414]">{renderPage()}</main>
                </div>
            </div>
        </div>
    );
};

const App = () => {
    const [db, setDb] = useState(null); const [userId, setUserId] = useState(null); const [authReady, setAuthReady] = useState(false);
    useEffect(() => {
        try {
            const app = initializeApp(firebaseConfig); const auth = getAuth(app); const dbInstance = getFirestore(app); setDb(dbInstance);
            const unsubscribe = onAuthStateChanged(auth, async (user) => {
                if (user) { setUserId(user.uid); setAuthReady(true); } 
                else { try { const token = typeof __initial_auth_token !== 'undefined' ? __initial_auth_token : null; if (token) { await signInWithCustomToken(auth, token); } else { await signInAnonymously(auth); } } catch (error) { console.error("Auth Error:", error); } }
            });
            return () => unsubscribe();
        } catch (error) { console.error("Firebase init failed:", error); }
    }, []);

    const GlobalStyles = () => ( <style>{` @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@700&family=Inter:wght@400;500&family=Roboto+Mono:wght@400&family=Plus+Jakarta+Sans:wght@500;700&display=swap'); body { font-family: 'Inter', sans-serif; background-color: #141414; color: #F3F4F6; background-image: url('data:image/svg+xml,%3Csvg width="6" height="6" viewBox="0 0 6 6" xmlns="http://www.w3.org/2000/svg"%3E%3Cg fill="%232a2a2a" fill-opacity="0.4" fill-rule="evenodd"%3E%3Cpath d="M5 0h1L0 6V5zM6 5v1H5z"/%3E%3C/g%3E%3C/svg%3E'); } .font-cormorant { font-family: 'Cormorant Garamond', serif; } .font-jakarta { font-family: 'Plus Jakarta Sans', sans-serif; } .font-mono { font-family: 'Roboto Mono', monospace; } `}</style> );
    if (!authReady || !db || !userId) { return ( <> <GlobalStyles /> <div className="flex items-center justify-center h-screen"> <div className="text-center"> <LoadingSpinner /> <p className="mt-4 text-lg font-jakarta text-gray-300">Connecting to Workspace...</p> </div> </div> </> ); }
    return ( <> <GlobalStyles /> <ChangeManagementApp db={db} userId={userId} /> </> );
};

export default App;

