const CapabilityAnalysisPanel = ({ assessments, isCollapsed, onToggle, onSuggestTraining }) => {
    const [selectedCapability, setSelectedCapability] = useState(null);
    const [isGenerating, setIsGenerating] = useState(false);

    const gapData = useMemo(() => {
        const gaps = assessments.reduce((acc, curr) => {
            const gap = (curr.target || 0) - (curr.current || 0);
            if(gap > 0){
                if (!acc[curr.capability] || gap > acc[curr.capability].gap) {
                    acc[curr.capability] = { gap, group: curr.group };
                }
            }
            return acc;
        }, {});
        return Object.keys(gaps).map(key => ({ capability: key, gap: gaps[key].gap, group: gaps[key].group })).sort((a,b) => b.gap - a.gap);
    }, [assessments]);

    const readinessData = useMemo(() => {
        const groups = {};
        assessments.forEach(a => {
            if(!groups[a.group]) groups[a.group] = { totalGap: 0, count: 0 };
            groups[a.group].totalGap += (a.target || 0) - (a.current || 0);
            groups[a.group].count++;
        });
        return Object.keys(groups).map(key => ({ group: key, avgGap: groups[key].totalGap / groups[key].count }));
    }, [assessments]);
    
    const handleSuggestClick = async () => {
        if (!selectedCapability) return;
        setIsGenerating(true);
        await onSuggestTraining(selectedCapability);
        setIsGenerating(false);
    };

    const getReadinessColor = (avgGap) => {
        if (avgGap <= 0) return 'bg-green-500';
        if (avgGap <= 1) return 'bg-yellow-500';
        return 'bg-red-500';
    };

    return (
        <>
            <div className={`fixed inset-0 bg-black/60 z-40 transition-opacity ${!isCollapsed ? 'opacity-100' : 'opacity-0 pointer-events-none'}`} onClick={onToggle}></div>
            <aside className={`fixed top-0 right-0 h-full w-full max-w-2xl bg-[#1F1F1F] border-l border-[#333] z-50 transition-transform duration-300 ease-in-out ${!isCollapsed ? 'translate-x-0' : 'translate-x-full'}`}>
                <div className="flex flex-col h-full">
                    <div className="p-6 flex justify-between items-center border-b border-[#333]">
                        <h3 className="font-jakarta text-xl font-bold text-[#B38B59] mb-0 whitespace-nowrap">Analysis Panel</h3>
                        <button onClick={onToggle} className="text-gray-400 hover:text-white"><ICONS.X className="w-6 h-6"/></button>
                    </div>
                    <div className="overflow-y-auto p-6">
                        <div className="flex flex-col gap-8">
                             <div>
                                <h4 className="font-jakarta text-lg text-white mb-4">Top Capability Gaps</h4>
                                 <ResponsiveContainer width="100%" height={300}>
                                    <BarChart data={gapData} layout="vertical" margin={{ top: 5, right: 20, left: 120, bottom: 5 }}>
                                        <CartesianGrid stroke="#333" strokeDasharray="3 3"/><XAxis type="number" stroke="#9ca3af" domain={[0, 5]} ticks={[1,2,3,4,5]}/><YAxis type="category" dataKey="capability" stroke="#9ca3af" width={120} tick={{ fontSize: 12 }}/>
                                        <Tooltip contentStyle={{ backgroundColor: '#141414', border: '1px solid #333', color: '#F3F4F6' }}/>
                                        <Bar dataKey="gap" name="Proficiency Gap" fill="#B38B59" onClick={(data) => setSelectedCapability(data)} cursor="pointer"/>
                                    </BarChart>
                                </ResponsiveContainer>
                            </div>
                             <div>
                                 <h4 className="font-jakarta text-lg text-white mb-4">Group Readiness Heatmap</h4>
                                 <div className="space-y-2">
                                     {readinessData.map(item => (
                                         <div key={item.group} className="flex items-center justify-between p-2 bg-[#141414] rounded">
                                             <span className="text-white">{item.group}</span>
                                             <div className={`w-24 h-6 rounded ${getReadinessColor(item.avgGap)} flex items-center justify-center text-xs font-bold text-white`}>
                                                 {item.avgGap > 0 ? `Gap: ${item.avgGap.toFixed(1)}` : 'Ready'}
                                             </div>
                                         </div>
                                     ))}
                                 </div>
                            </div>
                            {selectedCapability && (
                                <div className="p-4 bg-[#141414] rounded-lg border border-[#333]">
                                     <h4 className="font-jakarta text-lg text-white mb-2">Training Recommendation</h4>
                                     <p className="text-sm text-gray-400 mb-4">Generate an AI-powered training plan for the <span className="font-bold text-[#B38B59]">{selectedCapability.capability}</span> gap for the <span className="font-bold text-[#B38B59]">{selectedCapability.group}</span>.</p>
                                     <button onClick={handleSuggestClick} disabled={isGenerating} className="w-full flex items-center justify-center gap-2 px-4 py-2 bg-[#B38B59] text-white font-jakarta font-bold rounded-md hover:bg-[#a17c50] disabled:opacity-50">
                                        {isGenerating ? <LoadingSpinner small/> : <ICONS.Sparkles className="w-5 h-5" />}
                                        ✨ Suggest Training Plan
                                    </button>
                                </div>
                            )}
                        </div>
                    </div>
                </div>
            </aside>
        </>
    );
};


const CapabilityPage = ({ db, userId, project }) => {
    const [assessments, setAssessments] = useState([]);
    const [impactedGroups, setImpactedGroups] = useState([]);
    const [loading, setLoading] = useState(true);
    const [editingCell, setEditingCell] = useState(null);
    const [isAnalysisPanelOpen, setIsAnalysisPanelOpen] = useState(false);

    const capabilities = project?.capabilities || [];

    useEffect(() => {
        if (!project?.id) return;
        setLoading(true);
        const assessRef = collection(db, `artifacts/${appId}/users/${userId}/projects/${project.id}/capabilities`);
        const unsubAssess = onSnapshot(assessRef, snapshot => { setAssessments(snapshot.docs.map(doc => ({ id: doc.id, ...doc.data() }))); setLoading(false); });
        
        const impactsRef = collection(db, `artifacts/${appId}/users/${userId}/projects/${project.id}/impacts`);
        const unsubImpacts = onSnapshot(impactsRef, snapshot => {
            const groups = [...new Set(snapshot.docs.map(doc => doc.data().group))];
            setImpactedGroups(groups);
        });

        return () => { unsubAssess(); unsubImpacts(); };
    }, [db, userId, project?.id]);

    const handleCellChange = async (group, capability, field, value) => {
        const existing = assessments.find(a => a.group === group && a.capability === capability);
        const val = parseInt(value) || 0;
        if (existing) {
            await updateDoc(doc(db, `artifacts/${appId}/users/${userId}/projects/${project.id}/capabilities`, existing.id), { [field]: val });
        } else {
            await addDoc(collection(db, `artifacts/${appId}/users/${userId}/projects/${project.id}/capabilities`), { group, capability, [field]: val, current: field === 'target' ? 0 : val, target: field === 'current' ? 0 : val });
        }
        setEditingCell(null);
    };
    
    const handleSuggestTraining = async (capabilityGap) => {
        const { capability, group, gap } = capabilityGap;
        const prompt = `You are a corporate training expert. For a project, the "${group}" needs to improve their "${capability}" skill. Their current proficiency gap is ${gap} out of 5. Suggest a concise training plan with a "Topic", "Format" (e.g., Workshop, E-learning), and brief, bulleted "Learning Objectives".`;
        const suggestion = await callGeminiAPI(prompt);
        alert(`AI Suggestion for ${group} - ${capability}:\n\n${suggestion}`);
    };

    const getAssessmentValue = (group, capability) => {
        const assessment = assessments.find(a => a.group === group && a.capability === capability);
        return { current: assessment?.current || 0, target: assessment?.target || 0 };
    };

    return (
        <div className="h-full">
            <main className="flex-1 p-8 overflow-y-auto h-full">
                <div className="flex justify-between items-center mb-6">
                    <h2 className="font-jakarta text-3xl font-bold text-white">Capability Gap Analysis</h2>
                     <button onClick={() => setIsAnalysisPanelOpen(true)} className="flex items-center gap-2 px-4 py-2 bg-[#1F1F1F] border border-[#333] text-white font-jakarta font-bold rounded-md hover:bg-[#333] transition-all duration-300">
                         <ICONS.PanelRight className="w-5 h-5" /> Analysis
                     </button>
                </div>
                 <div className="bg-[#1F1F1F] border border-[#333] rounded-lg shadow-2xl overflow-x-auto">
                   {loading ? <LoadingSpinner/> : (
                        <table className="w-full text-left border-collapse">
                            <thead className="bg-[#141414]">
                                <tr>
                                    <th className="p-4 font-jakarta font-bold text-[#B38B59] uppercase text-sm tracking-wider sticky left-0 bg-[#141414]">Impacted Group</th>
                                    {capabilities.map(cap => (
                                        <th key={cap} className="p-4 font-jakarta font-bold text-[#B38B59] uppercase text-sm tracking-wider text-center min-w-[200px]">{cap}</th>
                                    ))}
                                </tr>
                            </thead>
                            <tbody className="divide-y divide-[#333]">
                                {impactedGroups.map(group => (
                                    <tr key={group} className="hover:bg-[#141414]">
                                        <td className="p-4 text-white font-bold sticky left-0 bg-[#1F1F1F] hover:bg-[#141414]">{group}</td>
                                        {capabilities.map(cap => {
                                            const { current, target } = getAssessmentValue(group, cap);
                                            const isEditingCurrent = editingCell?.group === group && editingCell?.capability === cap && editingCell?.field === 'current';
                                            const isEditingTarget = editingCell?.group === group && editingCell?.capability === cap && editingCell?.field === 'target';
                                            return (
                                                <td key={cap} className="p-4 text-center">
                                                    <div className="flex items-center justify-center gap-2">
                                                        {isEditingCurrent ? (
                                                            <input type="number" defaultValue={current} onBlur={(e) => handleCellChange(group, cap, 'current', e.target.value)} autoFocus className="w-16 p-1 bg-[#141414] border border-[#B38B59] rounded" />
                                                        ) : (
                                                            <span onClick={() => setEditingCell({group, capability: cap, field: 'current'})} className="cursor-pointer w-16 p-1 rounded hover:bg-[#333] text-gray-300">{current} / 5</span>
                                                        )}
                                                        <span className="text-gray-500">→</span>
                                                         {isEditingTarget ? (
                                                            <input type="number" defaultValue={target} onBlur={(e) => handleCellChange(group, cap, 'target', e.target.value)} autoFocus className="w-16 p-1 bg-[#141414] border border-[#B38B59] rounded" />
                                                        ) : (
                                                            <span onClick={() => setEditingCell({group, capability: cap, field: 'target'})} className="cursor-pointer w-16 p-1 rounded hover:bg-[#333] font-bold text-[#B38B59]">{target} / 5</span>
                                                        )}
                                                    </div>
                                                </td>
                                            )
                                        })}
                                    </tr>
                                ))}
                            </tbody>
                        </table>
                   )}
                 </div>
            </main>
            <CapabilityAnalysisPanel assessments={assessments} isCollapsed={!isAnalysisPanelOpen} onToggle={()=> setIsAnalysisPanelOpen(false)} onSuggestTraining={handleSuggestTraining} />
        </div>
    );
};


