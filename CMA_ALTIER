const RiskModal = ({ isOpen, onClose, db, userId, project, editingRisk }) => {
    const [formData, setFormData] = useState({});
    const [isGenerating, setIsGenerating] = useState(false);

    useEffect(() => {
        if (editingRisk) {
            setFormData(editingRisk);
        } else {
            setFormData({ description: '', likelihood: 3, impact: 3, mitigationPlan: '' });
        }
    }, [editingRisk, isOpen]);

    const handleChange = (e) => {
        const { name, value } = e.target;
        setFormData(prev => ({ ...prev, [name]: name === 'likelihood' || name === 'impact' ? parseInt(value) : value }));
    };

    const handleSuggestMitigation = async () => {
        if (!formData.description) {
            alert("Please provide a risk description first.");
            return;
        }
        setIsGenerating(true);
        const prompt = `You are a senior project manager specializing in risk mitigation. For a project, we have identified the following risk: "${formData.description}". The likelihood of this risk occurring is ${formData.likelihood}/5 and the potential impact is ${formData.impact}/5. Provide a concise, actionable mitigation plan in one or two sentences.`;
        const suggestion = await callGeminiAPI(prompt);
        setFormData(prev => ({ ...prev, mitigationPlan: suggestion }));
        setIsGenerating(false);
    };

    const handleSubmit = async (e) => {
        e.preventDefault();
        const collectionRef = collection(db, `artifacts/${appId}/users/${userId}/projects/${project.id}/risks`);
        if (formData.id) {
            await updateDoc(doc(collectionRef, formData.id), formData);
        } else {
            await addDoc(collectionRef, { ...formData, createdAt: serverTimestamp() });
        }
        onClose();
    };

    if (!isOpen) return null;
    return (
        <div className="fixed inset-0 bg-black bg-opacity-70 flex justify-center items-center z-50">
            <div className="bg-[#1F1F1F] border border-[#333] p-8 rounded-lg shadow-2xl w-full max-w-lg m-4">
                <h3 className="font-jakarta text-2xl font-bold text-[#B38B59] mb-6">{formData.id ? 'Edit' : 'Add'} Risk</h3>
                <form onSubmit={handleSubmit} className="space-y-4">
                    <textarea name="description" value={formData.description || ''} onChange={handleChange} placeholder="Risk Description" required className="w-full p-2 border border-[#333] rounded-md bg-[#141414] text-[#F3F4F6] min-h-[80px]"></textarea>
