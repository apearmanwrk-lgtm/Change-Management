                                    </ScatterChart>
                                </ResponsiveContainer>
                            </div>
                            <div>
                                <h4 className="font-jakarta text-lg text-white mb-4">Engagement Sentiment</h4>
                                <ResponsiveContainer width="100%" height={250}>
                                    <PieChart><Pie data={engagementData} dataKey="value" nameKey="name" cx="50%" cy="50%" outerRadius={80} label>{engagementData.map((entry, index) => (<Cell key={`cell-${index}`} fill={BRAND_COLORS[entry.name]} />))}</Pie><Tooltip contentStyle={{ backgroundColor: '#141414', border: '1px solid #333', color: '#F3F4F6' }}/><Legend wrapperStyle={{ color: '#E5E7EB' }} /></PieChart>
