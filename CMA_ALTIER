                        <button type="button" onClick={onClose} className="px-6 py-2 bg-[#333] text-white font-jakarta font-bold rounded-md hover:bg-[#444]">Cancel</button>
                        <button type="submit" className="px-6 py-2 bg-[#B38B59] text-white font-jakarta font-bold rounded-md hover:bg-[#a17c50]">Save</button>
                    </div>
                </form>
            </div>
        </div>
    );
