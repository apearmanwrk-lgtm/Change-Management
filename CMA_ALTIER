    useEffect(() => {
        if (editingImpact) {
            setFormData(editingImpact);
        } else {
            setFormData({ group: '', process: '', description: '', impactLevel: 3, impactType: 'Process' });
        }
    }, [editingImpact, isOpen]);
    
    const handleChange = (e) => {
        const { name, value } = e.target;
        setFormData(prev => ({ ...prev, [name]: name === 'impactLevel' ? parseInt(value) : value }));
    };

    const handleSuggestDescription = async () => {
        if (!formData.group || !formData.process) {
            alert("Please provide the Impacted Group and Process first.");
            return;
        }
        setIsGenerating(true);
        const prompt = `For a change management project called "${project.name}", describe the impact on the "${formData.group}" group regarding the "${formData.process}" process. Provide a concise description in a "From: [Old Way] To: [New Way]" format.`;
        const suggestion = await callGeminiAPI(prompt);
        setFormData(prev => ({ ...prev, description: suggestion }));
        setIsGenerating(false);
    };

    const handleSubmit = async (e) => {
        e.preventDefault();
        const collectionRef = collection(db, `artifacts/${appId}/users/${userId}/projects/${project.id}/impacts`);
        if (formData.id) {
            await updateDoc(doc(collectionRef, formData.id), formData);
        } else {
            await addDoc(collectionRef, { ...formData, createdAt: serverTimestamp() });
